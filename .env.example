# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: SOCIAL AGENT / SOCIAL BOOST
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOTOR DE BASE DE DATOS (DATABASE ENGINE)
# ------------------------------------------------------------------------------
# Opciones disponibles para DB_DRIVER / DB_CONNECTION:
# - sqlite   : Ideal para desarrollo local y cargas ligeras/medianas (con modo WAL)
# - pgsql    : Recomendado para producción masiva (+1,000 usuarios concurrentes, PostgreSQL 14+)
# - mysql    : Recomendado para producción masiva con MySQL 8.0+ o MariaDB 10.5+

DB_DRIVER=sqlite

# Configuración para SQLite:
# DB_DATABASE=data/social_agent.sqlite

# Configuración para PostgreSQL (Producción Masiva):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=social_agent_prod
# DB_USERNAME=postgres
# DB_PASSWORD=tu_password_seguro
# DB_SSLMODE=prefer

# Configuración para MySQL / MariaDB (Producción Masiva):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=social_agent_prod
# DB_USERNAME=root
# DB_PASSWORD=tu_password_seguro
# DB_CHARSET=utf8mb4

# O URL directa (PaaS como Supabase, Neon, AWS RDS, Render, Railway, Heroku):
# DATABASE_URL=postgresql://usuario:password@host.region.rds.amazonaws.com:5432/social_agent?sslmode=require

# ------------------------------------------------------------------------------
# 2. SEGURIDAD & CRON WORKERS
# ------------------------------------------------------------------------------
CRON_SECRET_KEY=cron_secure_token_2026
WEBHOOK_VERIFY_TOKEN=social_boost_secure_token_2026
SESSION_SECRET=genera_una_cadena_aleatoria_larga_de_64_caracteres

# ------------------------------------------------------------------------------
# 3. PROVEEDORES DE INTELIGENCIA ARTIFICIAL (OPENROUTER / HEURÍSTICO)
# ------------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 4. META GRAPH API (FACEBOOK & INSTAGRAM)
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
