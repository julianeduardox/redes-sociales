# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: XINDRO AI COPILOT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOTOR DE BASE DE DATOS (DATABASE ENGINE)
# ------------------------------------------------------------------------------
# Opciones disponibles para DB_DRIVER:
# - sqlite   : Desarrollo local y cargas medias (modo WAL)
# - pgsql    : Recomendado para producción masiva (+1,000 usuarios concurrentes)
# - mysql    : Recomendado para entornos MySQL 8.0+ o MariaDB 10.5+

DB_DRIVER=sqlite

# Ruta absoluta o relativa para SQLite (puede ubicarse fuera del DocumentRoot):
DB_DATABASE=data/social_agent.sqlite

# Configuración para PostgreSQL (Producción Masiva):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=social_agent_prod
# DB_USERNAME=postgres
# DB_PASSWORD=tu_password_seguro_generado
# DB_SSLMODE=prefer

# Configuración para MySQL / MariaDB:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=social_agent_prod
# DB_USERNAME=root
# DB_PASSWORD=tu_password_seguro_generado
# DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 2. CRIPTOGRAFÍA, SEGURIDAD & CORS
# ------------------------------------------------------------------------------
# Clave simétrica de 256 bits (64 caracteres hexadecimales) para cifrar tokens en reposo (AES-256-GCM)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
APP_ENCRYPTION_KEY=

# Clave secreta para el cron worker (ejecución remota vía URL)
# Generar con: php -r "echo bin2hex(random_bytes(24));"
CRON_SECRET_KEY=

# Token de verificación para Meta Webhook (GET challenge)
# Generar con: php -r "echo bin2hex(random_bytes(24));"
WEBHOOK_VERIFY_TOKEN=

# Orígenes CORS permitidos (separados por coma, coincidencia exacta sin comodines)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# URL canónica de la aplicación
APP_URL=http://localhost/Redes%20sociales

# Contraseña inicial del administrador (si se deja vacía en la primera instalación, se genera aleatoria)
# ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# 3. PROVEEDORES DE INTELIGENCIA ARTIFICIAL (OPENROUTER / HEURÍSTICO)
# ------------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. META GRAPH API (FACEBOOK & INSTAGRAM)
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
