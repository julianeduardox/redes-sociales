# ----------------------------------------------------------------------
# Hardened Apache Security Configuration for SocialBoost AI / Mente Estoica
# ----------------------------------------------------------------------

# 1. Disable Directory Indexing & Directory Browsing
Options -Indexes -MultiViews

# 2. Block Direct Access to Sensitive Files and Directories
<FilesMatch "^(\.env|\.git|\.sqlite|.*\.sqlite|.*\.db|composer\.(json|lock)|package(-lock)?\.json|\.htaccess|\.htpasswd|schema\.sql|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Protect Critical Folders (data, config, services)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block direct HTTP requests to internal system directories
    RewriteRule ^(data|config|services)/ - [F,L,NC]
</IfModule>

# 4. HTTP Security Headers (if mod_headers is enabled)
<IfModule mod_headers.c>
    # Prevent MIME Sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Prevent Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Enable XSS Filtering
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 5. Disable Server Signature for Information Disclosure Protection
ServerSignature Off
